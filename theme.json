{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1400px"
        },
        "color": {
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "slug": "primary",
                    "color": "#090D16",
                    "name": "Deep Carbon"
                },
                {
                    "slug": "accent",
                    "color": "#2563EB",
                    "name": "Electric Sapphire"
                },
                {
                    "slug": "speed-emerald",
                    "color": "#10B981",
                    "name": "Speed Emerald"
                },
                {
                    "slug": "background",
                    "color": "#FFFFFF",
                    "name": "Background"
                },
                {
                    "slug": "background-alt",
                    "color": "#F8FAFC",
                    "name": "Background Alt"
                },
                {
                    "slug": "card-surface",
                    "color": "#FFFFFF",
                    "name": "Card Surface"
                },
                {
                    "slug": "border-subtle",
                    "color": "#E2E8F0",
                    "name": "Border Subtle"
                },
                {
                    "slug": "foreground",
                    "color": "#090D16",
                    "name": "Foreground"
                },
                {
                    "slug": "foreground-light",
                    "color": "#64748B",
                    "name": "Foreground Light"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "slug": "display",
                    "name": "Plus Jakarta Sans"
                },
                {
                    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "slug": "sans",
                    "name": "Inter"
                }
            ],
            "fontSizes": [
                {
                    "slug": "x-small",
                    "size": "0.75rem",
                    "name": "X-Small"
                },
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "title-sm",
                    "size": "1.1rem",
                    "name": "Title Small"
                },
                {
                    "slug": "large",
                    "size": "1.25rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "1.5rem",
                    "name": "X Large"
                },
                {
                    "slug": "2x-large",
                    "size": "2.25rem",
                    "name": "2X Large"
                },
                {
                    "slug": "3x-large",
                    "size": "clamp(2.5rem, 5vw, 3.75rem)",
                    "name": "3X Large"
                }
            ]
        },
        "spacing": {
            "customSpacingSize": true,
            "spacingScale": {
                "steps": 0
            },
            "spacingSizes": [
                {
                    "slug": "small",
                    "size": "1rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "2rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "4rem",
                    "name": "Large"
                },
                {
                    "slug": "section",
                    "size": "6rem",
                    "name": "Section"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--accent)"
                }
            },
            "button": {
                "border": {
                    "radius": "0.5rem"
                },
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "#ffffff"
                },
                "spacing": {
                    "padding": {
                        "top": "0.875rem",
                        "bottom": "0.875rem",
                        "left": "1.75rem",
                        "right": "1.75rem"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontWeight": "600"
                }
            }
        },
        "blocks": {
            "core/heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em"
                }
            },
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "1.1rem",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em"
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "page-services",
            "title": "Services Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-pricing",
            "title": "Pricing Page",
            "postTypes": ["page"]
        }
    ],
    "templateParts": {
        "header": {
            "area": "header"
        },
        "footer": {
            "area": "footer"
        }
    }
}
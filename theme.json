{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1400px"
        },
        "color": {
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "slug": "primary",
                    "color": "#1A1A1A",
                    "name": "Edge Charcoal"
                },
                {
                    "slug": "accent",
                    "color": "#1A59C8",
                    "name": "Edge Precision Blue"
                },
                {
                    "slug": "accent-hover",
                    "color": "#14459B",
                    "name": "Edge Hover Blue"
                },
                {
                    "slug": "edge-brightblue",
                    "color": "#008DFF",
                    "name": "Edge Bright Blue"
                },
                {
                    "slug": "edge-cyan",
                    "color": "#82DDFD",
                    "name": "Edge Soft Cyan"
                },
                {
                    "slug": "edge-purple",
                    "color": "#6A0DD4",
                    "name": "Copilot AI Purple"
                },
                {
                    "slug": "speed-emerald",
                    "color": "#0AD88F",
                    "name": "Edge Speed Green"
                },
                {
                    "slug": "edge-yellow",
                    "color": "#FEC846",
                    "name": "Edge Yellow"
                },
                {
                    "slug": "background",
                    "color": "#FFFFFF",
                    "name": "Pure White"
                },
                {
                    "slug": "background-alt",
                    "color": "#F2F2F2",
                    "name": "Edge Light Gray"
                },
                {
                    "slug": "card-surface",
                    "color": "#FFFFFF",
                    "name": "Card Surface"
                },
                {
                    "slug": "border-subtle",
                    "color": "#E5E7EB",
                    "name": "Border Subtle"
                },
                {
                    "slug": "foreground",
                    "color": "#1A1A1A",
                    "name": "Foreground Text"
                },
                {
                    "slug": "foreground-light",
                    "color": "#5A5A5A",
                    "name": "Neutral Body Text"
                }
            ],
            "gradients": [
                {
                    "slug": "edge-hero-gradient",
                    "gradient": "linear-gradient(180deg, #D9F0F3 0%, #C4ECF8 20%, #FCFCFC 60%, #FFFFFF 100%)",
                    "name": "Edge Hero Gradient"
                },
                {
                    "slug": "edge-ai-gradient",
                    "gradient": "linear-gradient(90deg, #BA99FF 0%, #ABD8FF 50%, #8BFAEB 100%)",
                    "name": "Copilot AI Gradient"
                },
                {
                    "slug": "edge-vibrant-gradient",
                    "gradient": "linear-gradient(90deg, #7209D4 0%, #2832D4 33%, #00A5B2 100%)",
                    "name": "Edge Vibrant Gradient"
                },
                {
                    "slug": "edge-section-grad",
                    "gradient": "linear-gradient(103deg, #F5F6FF 10%, #DFF4FB 100%)",
                    "name": "Edge Soft Section Gradient"
                }
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "slug": "display",
                    "name": "Plus Jakarta Sans"
                },
                {
                    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "slug": "sans",
                    "name": "Inter"
                }
            ],
            "fontSizes": [
                {
                    "slug": "x-small",
                    "size": "0.75rem",
                    "name": "X-Small"
                },
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "title-sm",
                    "size": "1.1rem",
                    "name": "Title Small"
                },
                {
                    "slug": "large",
                    "size": "1.25rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "1.5rem",
                    "name": "X Large"
                },
                {
                    "slug": "2x-large",
                    "size": "2.25rem",
                    "name": "2X Large"
                },
                {
                    "slug": "3x-large",
                    "size": "clamp(2.5rem, 5vw, 3.75rem)",
                    "name": "3X Large"
                }
            ]
        },
        "spacing": {
            "customSpacingSize": true,
            "spacingScale": {
                "steps": 0
            },
            "spacingSizes": [
                {
                    "slug": "small",
                    "size": "1rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "2rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "4rem",
                    "name": "Large"
                },
                {
                    "slug": "section",
                    "size": "6rem",
                    "name": "Section"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--background)",
            "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--accent)"
                }
            },
            "button": {
                "border": {
                    "radius": "9999px"
                },
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "#ffffff"
                },
                "spacing": {
                    "padding": {
                        "top": "0.875rem",
                        "bottom": "0.875rem",
                        "left": "1.75rem",
                        "right": "1.75rem"
                    }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontWeight": "600"
                }
            }
        },
        "blocks": {
            "core/heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em"
                }
            },
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "1.1rem",
                    "fontWeight": "700",
                    "letterSpacing": "-0.02em"
                }
            }
        }
    },
    "customTemplates": [
        {
            "name": "page-services",
            "title": "Services Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-managed-hosting",
            "title": "Managed Hosting Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-custom-builds",
            "title": "Custom Builds Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-pricing",
            "title": "Pricing Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-case-studies",
            "title": "Case Studies Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-woocommerce",
            "title": "WooCommerce Speed Optimization Page",
            "postTypes": ["page"]
        },
        {
            "name": "page-case-study-coaching",
            "title": "Coaching Case Study Page",
            "postTypes": ["page"]
        }
    ],
    "templateParts": {
        "header": {
            "area": "header"
        },
        "footer": {
            "area": "footer"
        }
    }
}